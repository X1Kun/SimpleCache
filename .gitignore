# Ignore local executable artifacts.
geecache_server.exe
*.exe

# Ignore Go build and test artifacts.
bin/
*.test
*.out

# Ignore local editor and operating-system files.
.DS_Store
.idea/
.vscode/
geecache_server
geecache-server
/geecache-engine/server

# Prevent local handoff records from being accidentally reintroduced.
/docs/REFACTOR_STATE.md
/docs/VALIDATION.md
/docs/legacy/

# Local Python validation imports.
__pycache__/
*.pyc
